# AttachSurfer Configuration
# Copy this file to .env and customize

# --- Search API Keys (required for search) ---

# Bing Web Search API key (get from https://portal.azure.com)
VITE_BING_API_KEY=

# Google Custom Search API key (get from https://console.cloud.google.com)
VITE_GOOGLE_API_KEY=
# Google Custom Search Engine ID (get from https://programmablesearchengine.google.com)
VITE_GOOGLE_CX=

# Bright Data SERP API key (get from https://brightdata.com)
VITE_BRIGHTDATA_API_KEY=
# Bright Data SERP Zone (default: serp)
VITE_BRIGHTDATA_ZONE=serp

# --- Defaults ---
VITE_DEFAULT_SEARCH_ENGINE=all
VITE_DEFAULT_RESULT_COUNT=3

# --- AI Models (in-browser only) ---
VITE_AI_MODEL=gemma4
VITE_AI_BACKEND=auto
VITE_WEBLLM_MODEL=Phi-4-mini-instruct-q4f16_1-MLC
VITE_GEMMA_MODEL=gemma-4-E2B-it-web
VITE_EMBEDDING_MODEL=embeddinggemma2
# Local directory serving path for downloaded models (served by Vite/web server)
VITE_LOCAL_MODELS_PATH=/models

# --- Features ---
VITE_TELEMETRY_ENABLED=true
VITE_STORE_HISTORY=true
